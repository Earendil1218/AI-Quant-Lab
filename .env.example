# 复制为 .env 后在本机填写或调整；请勿将 .env 提交到 Git。
# IBKR TWS API 通过已登录的 TWS 会话连接，不应在此保存账户密码。

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=2

# 默认历史数据请求参数
DEFAULT_SYMBOL=NVDA
DEFAULT_DURATION=1 Y
DEFAULT_BAR_SIZE=1 day

# 未来如接入第三方数据服务，在本机 .env 中填写真实值。
# MARKET_DATA_API_KEY=

# 中文：独立执行配置默认关闭；这些开关不能解锁 Phase 3H 的真实订单 transport。
# English: Separate execution defaults to disabled; flags cannot unlock Phase 3H real orders.
IBKR_TRADING_MODE=DISABLED
IBKR_EXECUTION_HOST=127.0.0.1
IBKR_EXECUTION_PORT=7497
IBKR_EXECUTION_CLIENT_ID=3
IBKR_PAPER_ACCOUNT=
IBKR_PAPER_ACCOUNT_ALLOWLIST=
RUN_IBKR_PAPER_INTEGRATION=0
ALLOW_IBKR_PAPER_ORDER_SIDE_EFFECTS=NO
